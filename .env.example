# === AEGIS Backend (Python, port 8000) ===
AEGIS_PORT=8000
AEGIS_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEGIS_FULL_ACCESS=false
# Privacy defaults: local models only; cloud realtime requires both settings
# below to be explicitly changed by the operator.
AEGIS_LOCAL_FIRST=true
AEGIS_VOICE_TRANSPORT=local
AEGIS_REALTIME_MODEL=gpt-realtime
AEGIS_REALTIME_VOICE=alloy

# === AUTH (all env-driven; NO hardcoded defaults in code) ===
# 4-8 digit handshake PIN used by the HUD /auth/handshake
JARVIS_PIN=change_me_pin
# API key accepted via X-Jarvis-Key / x-api-key headers (constant-time compared)
JARVIS_API_KEY=change_me_length_32_chars_min
JWT_SECRET=change_me_64_char_hex_secret
API_KEY=change_me_length_32_chars_min

# === Legacy Node enterprise gateway (optional profile, port 4000) ===
PORT=4000
MONGO_URI=mongodb://localhost:27017/jarvis
MONGO_USER=jarvis_admin
MONGO_PASSWORD=change_me
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change_me
GITHUB_TOKEN=your_github_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret
NODE_ENV=development

# === Cloud AI Models (Hybrid Mode) ===
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
